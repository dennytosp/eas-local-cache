{
  "name": "eas-local-cache",
  "version": "1.0.3",
  "description": "A custom build cache provider for Expo CLI. Uses local to store builds.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "bun test",
    "prepack": "bun run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dennytosp/eas-local-cache.git"
  },
  "keywords": [
    "expo",
    "expo-cache",
    "eas-cache",
    "build-cache",
    "buildCacheProvider",
    "expo-cli",
    "react-native"
  ],
  "author": "mad.dinh",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dennytosp/eas-local-cache/issues"
  },
  "homepage": "https://github.com/dennytosp/eas-local-cache#readme",
  "devDependencies": {
    "@expo/config": "^57.0.7",
    "@types/bun": "^1.3.14",
    "expo-module-scripts": "^4.1.10",
    "typescript": "^5.9.2"
  },
  "files": [
    "build",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
