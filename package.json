{
  "name": "eas-local-cache",
  "version": "1.0.4",
  "description": "An offline, self-healing build cache provider for local Expo CLI builds.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "bin": {
    "eas-local-cache": "build/cli-bin.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "format": "prettier --write \".github/**/*.{yml,yaml}\" \".agents/**/*.md\" \"docs/**/*.md\" \"scripts/**/*.{js,mjs}\" \"src/**/*.{ts,tsx}\" \"test/**/*.{js,mjs,ts,tsx}\" package.json",
    "format:check": "prettier --check \".github/**/*.{yml,yaml}\" \".agents/**/*.md\" \"docs/**/*.md\" \"scripts/**/*.{js,mjs}\" \"src/**/*.{ts,tsx}\" \"test/**/*.{js,mjs,ts,tsx}\" package.json",
    "lint": "oxlint --deny-warnings src test",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "bun test",
    "example:check": "bun run build && bun run --cwd example check",
    "prepack": "bun run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dennytosp/eas-local-cache.git"
  },
  "keywords": [
    "expo",
    "expo-cache",
    "eas-cache",
    "build-cache",
    "buildCacheProvider",
    "expo-cli",
    "react-native"
  ],
  "author": "mad.dinh",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dennytosp/eas-local-cache/issues"
  },
  "homepage": "https://github.com/dennytosp/eas-local-cache#readme",
  "devDependencies": {
    "@expo/config": "^57.0.7",
    "@types/bun": "^1.3.14",
    "expo-module-scripts": "^56.0.3",
    "oxlint": "1.78.0",
    "prettier": "3.9.6",
    "typescript": "^7.0.2"
  },
  "files": [
    "build",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "selfsigned": "^5.5.0"
  }
}
