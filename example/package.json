{
  "name": "eas-local-cache-example",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "verify:provider": "node ./scripts/verify-provider.mjs",
    "cache:test:ios": "bash ./scripts/test-cache-native.sh ios",
    "cache:test:android": "bash ./scripts/test-cache-native.sh android",
    "cache:test:environment:ios": "bash ./scripts/test-cache-environment.sh ios",
    "cache:test:environment:android": "bash ./scripts/test-cache-environment.sh android",
    "cache:test:compression:ios": "bash ./scripts/test-cache-compression.sh ios",
    "cache:test:compression:android": "bash ./scripts/test-cache-compression.sh android",
    "cache:stats": "node ../build/cli-bin.js stats --project-root .",
    "cache:list": "node ../build/cli-bin.js list --project-root .",
    "cache:doctor": "node ../build/cli-bin.js doctor --project-root .",
    "cache:prune": "node ../build/cli-bin.js prune --project-root . --dry-run",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run verify:provider",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "expo": "~57.0.0",
    "expo-constants": "~57.0.2",
    "expo-linking": "~57.0.1",
    "expo-router": "~57.0.2",
    "expo-splash-screen": "~57.0.1",
    "expo-status-bar": "~57.0.0",
    "heroui-native": "^1.0.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.2",
    "uniwind": "^1.10.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.15",
    "eas-local-cache": "file:..",
    "eslint": "^9.39.4",
    "eslint-config-expo": "^57.0.0",
    "prettier": "^3.8.3",
    "typescript": "~6.0.3"
  }
}
