{
  "expo": {
    "name": "EAS Local Cache Example",
    "slug": "eas-local-cache-example",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "eas-local-cache-example",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.dennytosp.easlocalcache.example",
      "supportsTablet": true
    },
    "android": {
      "package": "com.dennytosp.easlocalcache.example",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-status-bar"
    ],
    "buildCacheProvider": {
      "plugin": "eas-local-cache",
      "options": {
        "maxSize": "20GB",
        "maxEntries": 50,
        "retentionDays": 14,
        "autoPrune": true,
        "toolchain": "safe",
        "compression": "off"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
